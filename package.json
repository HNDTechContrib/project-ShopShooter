{
  "name": "shop-shooter-game",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/library/index.js",
  "module": "./dist/library/index.js",
  "types": "./dist/library/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/public-api.d.ts",
      "import": "./dist/library/index.js",
      "default": "./dist/library/index.js"
    }
  },
  "files": [
    "dist/library",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "bun run build:app && bun run build:lib",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepare": "bun run build:lib",
    "start": "bun server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas-confetti": "^1.9.4",
    "express": "^5.3.0",
    "lucide-react": "^1.64.0",
    "vite": "^8.3.5",
    "ws": "^8.22.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "@types/express": "^5.0.6"
  }
}
